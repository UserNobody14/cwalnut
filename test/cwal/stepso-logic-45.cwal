# Logic 45 (stepso2.test.ts): reflexive transitive closure — app(lam(tie(a, lam(tie(b, var(a))))), var(b)) steps to q.
# Inlined: substo2, betao, stepo, stepso (no import yet).
# Predicate-in-expression: first arg is implied (unified with position), e.g. substo2(tie(A, E1), E, Out), Idtm = tie(A, ["app", Args]).
# App spine is still ["app", Args] with Args = [M, N] — not a flat three-tail list.

substo2 = (Idtm, E, Out) =>
    either:
        fresh nominal A:
            Idtm = tie(A, ["var", A])
            E = Out
        fresh nominal A:
            fresh B:
                hash(A, B)
                Idtm = tie(A, ["var", B])
                Out = ["var", B]
        fresh nominal A, B:
            fresh E1, E1Hat:
                hash(B, E)
                Idtm = tie(A, ["lam", tie(B, E1)])
                substo2(tie(A, E1), E, E1Hat)
                Out = ["lam", tie(B, E1Hat)]
        fresh nominal A:
            fresh E1, E2, E1Hat, E2Hat, T1, T2:
                Idtm = tie(A, ["app", [E1, E2]])
                Out = ["app", [E1Hat, E2Hat]]
                substo2(tie(A, E1), E, E1Hat)
                substo2(tie(A, E2), E, E2Hat)

betao = (T1, EHatHat) =>
    all:
        fresh nominal b:
            fresh E, EHat, Lam, AppArgs:
                Lam = ["lam", tie(b, E)]
                AppArgs = [Lam, EHat]
                T1 = ["app", AppArgs]
                substo2(tie(b, E), EHat, EHatHat)

stepo = (T1, T2) =>
    either:
        betao(T1, T2)
        fresh M, N, MHat:
            Args1 = [M, N]
            Args2 = [MHat, N]
            T1 = ["app", Args1]
            T2 = ["app", Args2]
            stepo(M, MHat)
        fresh M, N, NHat:
            Args1 = [M, N]
            Args2 = [M, NHat]
            T1 = ["app", Args1]
            T2 = ["app", Args2]
            stepo(N, NHat)

stepso = (T1, T2) =>
    either:
        T1 = T2
        fresh T:
            stepo(T1, T)
            stepso(T, T2)

fresh nominal a, b:
    fresh Va, Vb, TieB, LamB, TieA, OuterLam, AppArgs, Input:
        Va = ["var", a]
        Vb = ["var", b]
        tie(TieB, b, Va)
        LamB = ["lam", TieB]
        tie(TieA, a, LamB)
        OuterLam = ["lam", TieA]
        AppArgs = [OuterLam, Vb]
        Input = ["app", AppArgs]
        stepso(Input, q)
